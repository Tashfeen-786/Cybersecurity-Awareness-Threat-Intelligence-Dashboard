# ============================================================================
# Cybersecurity Awareness & Threat Intelligence Dashboard - environment config
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values:
#     copy .env.example .env        (Windows)
#     cp  .env.example  .env        (Linux/macOS)
#
# SECURITY: .env is listed in .gitignore and must NEVER be committed.
# These DEMO keys exist only so the local educational demo can show
# authentication + RBAC. Change them for any shared deployment.
# ============================================================================

# --- Demo API keys (RBAC roles: viewer / analyst / admin) --------------------
API_KEY_VIEWER=demo-viewer-key
API_KEY_ANALYST=demo-analyst-key
API_KEY_ADMIN=demo-admin-key

# --- Application secret (used for future session/token signing) -------------
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-secret

# --- Database ----------------------------------------------------------------
# SQLite file used by the backend (created by scripts/init_database.py)
DATABASE_PATH=backend/threat_intel.db

# --- API rate limiting ---------------------------------------------------------
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# --- Alert engine thresholds (tune to change SOC alert volume) ----------------
ALERT_RISK_THRESHOLD=70
ALERT_CONFIDENCE_RISK_THRESHOLD=55
ALERT_CONFIDENCE_THRESHOLD=80
ALERT_REPEATED_OBSERVATION_COUNT=8
ALERT_CORRELATION_CLUSTER_SIZE=3
VULN_PRIORITY_ALERT_THRESHOLD=85

# --- CORS (local demo is permissive; restrict in production) ------------------
CORS_ALLOW_ORIGINS=*
